# Frontend env (Vite). Only VITE_* vars are exposed to the browser.
# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Never put secrets here (no OpenAI keys, no GitHub PATs).
# Those belong in backend/.env only.

# API path used by the SPA (proxied in dev)
VITE_API_BASE_URL=/api

# Dev-server proxy target (backend)
VITE_API_PROXY_TARGET=http://localhost:3000

# Vite dev server
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Optional display name
VITE_APP_NAME=git-contact
