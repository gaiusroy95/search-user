# GitHub Personal Access Token (classic or fine-grained with public read access)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Server port (default: 3000)
PORT=3000

# Frontend origin for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# In-memory cache TTL in seconds (default: 300)
CACHE_TTL_SECONDS=300

# Team collaboration auth (change in production)
AUTH_SECRET=your-random-secret-here

# API base URL for OAuth redirect callbacks
API_BASE_URL=http://localhost:3000

# Integration OAuth (optional — demo mode works without these)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
# GREENHOUSE_OAUTH_CLIENT_ID=
# GREENHOUSE_OAUTH_CLIENT_SECRET=
# LEVER_OAUTH_CLIENT_ID=
# LEVER_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# OUTLOOK_OAUTH_CLIENT_ID=
# OUTLOOK_OAUTH_CLIENT_SECRET=
